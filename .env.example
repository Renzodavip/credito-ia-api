# Copiá este archivo como .env y completá. El .env nunca se sube al repo.

# Opción A: Ollama local (gratis). Desde Docker, Ollama se ve en host.docker.internal
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://host.docker.internal:11434

# Opción B: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=tu-clave
